{
  "name": "cloudflare-webpage",
  "main": "./scripts/index.js",
  "compatibility_date": "2026-08-29",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "INTERNAL_API_KEY"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/test"]
  },
  "kv_namespaces": [
    {
      "binding": "HTML_KV",
      "id": "dde65671e6474e378814113b20f79eeb"
    }
  ]
}