{
  "name": "cloudflare-webpage",
  "main": "./scripts/index.js",
  "compatibility_date": "2026-06-30",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html"]
  },
  "kv_namespaces": [
    {
      "binding": "WEBPAGE_KV",
      "id": "9fd7e9f61bc94405892ecbb6903f89b8"
    }
  ],
  "services": [
    {
      "binding": "GET_GITHUB_JSON",
      "service": "gather-github-json"
    },
    {
      "binding": "MARKDOWN_TO_HTML",
      "service": "markdown-to-html"
    }
  ]
}